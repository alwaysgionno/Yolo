# =============================================================================
#  CONFIGURAZIONE - copia questo file in ".env" e personalizza i valori
#  Il file .env contiene credenziali: NON condividerlo e NON committarlo.
# =============================================================================

# ----- Server (broker MQTT) -----
# La telecamera non accede al database: riceve l'elenco delle persone e invia gli eventi
# attraverso il broker MQTT del server (repository face-access-server).
# MQTT_HOST: indirizzo IP del computer su cui gira il server (127.0.0.1 se e lo stesso computer).
# Usa un indirizzo IP e non "localhost": su Windows "localhost" prova prima IPv6 e rallenta la connessione.
MQTT_HOST=127.0.0.1
# MQTT_PORT: lo stesso valore di MQTT_PORT nel .env del server.
MQTT_PORT=1883
MQTT_USERNAME=camera
# MQTT_PASSWORD: lo stesso valore di MQTT_CAMERA_PASSWORD nel .env del server.
MQTT_PASSWORD=cambia_la_password_della_telecamera

# ----- Webcam -----
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ----- Modelli di intelligenza artificiale -----
YOLO_MODEL_PATH=models/yolov8n-face.pt
YOLO_CONFIDENCE=0.5
YOLO_IMAGE_SIZE=640
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=320

# ----- Soglie di riconoscimento (similarita coseno, da 0 a 1) -----
# Sopra RECOGNITION_THRESHOLD la persona e riconosciuta.
# Sopra CONTINUOUS_LEARNING_THRESHOLD il profilo viene arricchito (deve essere >= della soglia sopra).
RECOGNITION_THRESHOLD=0.40
CONTINUOUS_LEARNING_THRESHOLD=0.55

# ----- Comportamento applicativo -----
# "Bentornato" compare solo dopo un'assenza dal campo visivo di almeno questi secondi
WELCOME_BACK_ABSENCE_SECONDS=600
UNKNOWN_SNOOZE_SECONDS=60
# Un volto sconosciuto deve restare inquadrato per questo tempo prima che venga chiesto il nome
UNKNOWN_CONFIRM_SECONDS=1.5
ENROLLMENT_SAMPLES=8
MIN_FACE_WIDTH_PX=90
MIN_SHARPNESS=60
CONTINUOUS_BATCH_SIZE=5
CONTINUOUS_MIN_INTERVAL_SECONDS=600
TOP_K_NEIGHBORS=5
